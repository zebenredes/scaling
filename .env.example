# --- Supabase (Project Settings > API) ---
NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Solo servidor: webhooks, widget público y cron. Nunca exponer al navegador.
SUPABASE_SERVICE_ROLE_KEY=

# URL pública de la app (para el widget y callbacks)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- IA (Claude) ---
ANTHROPIC_API_KEY=

# --- Captación de clientes (Módulo 7) ---
APIFY_TOKEN=                 # Scraping Google Maps / LinkedIn (actores de Apify)
CLAY_WEBHOOK_URL=            # Tabla de Clay para enrichment (opcional)

# --- Servicio 1: Cold Email ---
RESEND_API_KEY=              # Envío transaccional (o cambia el proveedor en src/lib/integrations/email.ts)

# --- Servicio 3: Redes sociales ---
SOCIAL_PUBLISH_WEBHOOK_URL=  # n8n / Make / Zapier que publica el post

# --- Servicio 4: GoHighLevel ---
GHL_API_KEY=                 # Private Integration Token
GHL_LOCATION_ID=

# --- Servicio 5: WhatsApp Cloud API ---
WHATSAPP_TOKEN=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=         # Para validar la firma X-Hub-Signature-256

# --- Servicio 6: Voz (Vapi) ---
VAPI_API_KEY=
VAPI_PHONE_NUMBER_ID=
VAPI_WEBHOOK_SECRET=         # Se envía como x-vapi-secret a /api/webhooks/voice

# Protege /api/cron/* (Vercel Cron envía Authorization: Bearer $CRON_SECRET)
CRON_SECRET=
